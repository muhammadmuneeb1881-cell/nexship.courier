# Copy this file to .env.local (development) and set the same values in your
# hosting provider's environment variables panel (production) before deploying.

# ============================================================
# DATABASE — Supabase (Postgres). Required.
# ============================================================
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ============================================================
# ADMIN PANEL
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
# Secret used to sign BOTH admin and merchant session tokens — set this to a
# long random string (e.g. `openssl rand -hex 32`) and keep it identical
# across all deployed instances/regions.
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string

# ============================================================
# EMAIL (SMTP) — used for order/inquiry/support-ticket notifications
# ============================================================
# Preferred: explicit SMTP works with any provider (Gmail, Hostinger, Zoho,
# SendGrid SMTP, etc).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Backward-compatible Gmail shorthand (used only if SMTP_HOST is unset).
# EMAIL_PASS must be a 16-character Gmail "App Password", not your real
# password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-app-password

# Inbox that receives order/inquiry/support-ticket notification emails.
EMAIL_TO=nexship.courier@gmail.com

# ============================================================
# WHATSAPP — order alerts (WhatsApp Cloud API) + Support Center button
# ============================================================
# Meta WhatsApp Cloud API — sends the admin a WhatsApp message on new orders.
WHATSAPP_CLOUD_API_TOKEN=your-meta-cloud-api-token
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=your-phone-number-id
ADMIN_WHATSAPP_NUMBER=923xxxxxxxxx

# Public "Chat on WhatsApp" button number (international format, no +/spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=923xxxxxxxxx

# ============================================================
# SUPPORT CENTER (replaces the old AI chat widget)
# ============================================================
NEXT_PUBLIC_SUPPORT_PHONE=+923122347756
NEXT_PUBLIC_SUPPORT_EMAIL=nexship.courier@gmail.com

# ============================================================
# MERCHANT ACCOUNT — "Talk to Sales" dropdown in the navbar
# ============================================================
# Optional overrides — if unset, these fall back to
# NEXT_PUBLIC_SUPPORT_EMAIL / NEXT_PUBLIC_WHATSAPP_NUMBER above.
NEXT_PUBLIC_SALES_EMAIL=nexship.courier@gmail.com
NEXT_PUBLIC_SALES_WHATSAPP=923xxxxxxxxx
