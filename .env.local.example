# Copy this file to .env.local and change these values before deploying.

# Anthropic API key used by the AI chatbot (/api/chat).
# Get one from: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=your_real_api_key_here

# Admin panel login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Secret used to sign admin login sessions — set this to a long random string
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string

# Gmail SMTP settings used to email new plan/sales inquiries to your inbox.
# EMAIL_USER must be a Gmail address, and EMAIL_PASS must be a 16-character
# "App Password" generated from that account (NOT your normal Gmail password).
# How to generate one: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be turned on for the Google account first.)
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-app-password

# The inbox that should receive inquiry notifications.
EMAIL_TO=nexship.courier@gmail.com
